# Copy to .env on each server and fill in. .env is not committed to git.

# development | testing | production (default: production)
CI_ENV=production

# Database (required)
DB_HOST=localhost
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Optional: fixed site URL. If empty, it is worked out from the request.
BASE_URL=

# ABDM bridge
ABDM_ENABLED=true
ABDM_BRIDGE_URL=https://abdm.yourhospital.in
ABDM_API_KEY=
ABDM_CRON_KEY=
ABDM_MRN_PREFIX=SH
ABDM_SYNC_FROM=2024-01-01
ABDM_RESYNC_DAYS=7
ABDM_BATCH_SIZE=200
